@model MediCare.Models.Doctor
@{
    ViewData["Title"] = "Edit Doctor";
}

<div class="bg-dark text-white py-4 mb-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small text-white-50">
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-white text-decoration-none">Dashboard</a></li>
                        <li class="breadcrumb-item"><a asp-action="Doctors" class="text-white text-decoration-none">Doctors</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Edit: @Model.Name</li>
                    </ol>
                </nav>
                <h2 class="fw-bold mb-0">Edit Doctor Profile</h2>
            </div>
            <a asp-action="Doctors" class="btn btn-outline-light rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Back to Doctors
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-card">
                <form asp-action="EditDoctor" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

                    <!-- Row 1: Name and Specialization -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Doctor Full Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person-badge"></i></span>
                                <input asp-for="Name" class="form-control" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Specialization" class="form-label">Specialization / Department <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-heart-pulse"></i></span>
                                <input asp-for="Specialization" class="form-control" />
                            </div>
                            <span asp-validation-for="Specialization" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Row 2: Experience and Fee -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Experience" class="form-label">Experience (Years) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-award"></i></span>
                                <input asp-for="Experience" class="form-control" type="number" min="0" max="70" />
                            </div>
                            <span asp-validation-for="Experience" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConsultationFee" class="form-label">Consultation Fee (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-currency-rupee"></i></span>
                                <input asp-for="ConsultationFee" class="form-control" type="number" step="50" min="0" />
                            </div>
                            <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Row 3: Available Days and Profile Picture URL -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="AvailableDays" class="form-label">Available Days <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-calendar3"></i></span>
                                <input asp-for="AvailableDays" class="form-control" />
                            </div>
                            <span asp-validation-for="AvailableDays" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProfilePictureUrl" class="form-label">Photo URL / Asset Path</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-image"></i></span>
                                <input asp-for="ProfilePictureUrl" class="form-control" />
                            </div>
                            <span asp-validation-for="ProfilePictureUrl" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Row 4: Bio / Description -->
                    <div class="mb-3">
                        <label asp-for="Bio" class="form-label">Biography / Qualifications</label>
                        <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>

                    <!-- Checkbox: IsActive -->
                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">
                            Active (available for patient booking)
                        </label>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Doctors" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5">
                            <i class="bi bi-check2-circle me-1"></i> Update Doctor
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
