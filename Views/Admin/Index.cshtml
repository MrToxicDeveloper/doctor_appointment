@model MediCare.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="bg-dark text-white py-4 mb-4">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <span class="badge bg-primary text-uppercase px-3 py-1 mb-2">MediCare Administration</span>
                <h2 class="fw-bold mb-0">Clinic Control Center</h2>
            </div>
            <div class="d-flex gap-2 mt-3 mt-md-0">
                <a asp-controller="Admin" asp-action="Appointments" class="btn btn-outline-light rounded-pill">
                    <i class="bi bi-card-checklist me-1"></i> All Appointments
                </a>
                <a asp-controller="Admin" asp-action="Doctors" class="btn btn-outline-light rounded-pill">
                    <i class="bi bi-people me-1"></i> Manage Doctors
                </a>
                <a asp-controller="Admin" asp-action="CreateDoctor" class="btn btn-primary rounded-pill">
                    <i class="bi bi-person-plus me-1"></i> Add New Doctor
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Stat Cards Row -->
    <div class="row g-3 mb-4">
        <!-- Total Doctors -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-hospital"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.TotalDoctors</h3>
                    <span class="text-muted small">Specialist Doctors</span>
                </div>
            </div>
        </div>

        <!-- Total Appointments -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon bg-info-subtle text-info">
                    <i class="bi bi-calendar3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.TotalAppointments</h3>
                    <span class="text-muted small">Total Bookings</span>
                </div>
            </div>
        </div>

        <!-- Pending Appointments -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.PendingAppointments</h3>
                    <span class="text-muted small">Pending Approval</span>
                </div>
            </div>
        </div>

        <!-- Confirmed Appointments -->
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.ConfirmedAppointments</h3>
                    <span class="text-muted small">Confirmed Bookings</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Buttons for Status -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">
            <i class="bi bi-calendar-event text-primary me-2"></i>Appointments Management
        </h5>
        <div class="btn-group btn-group-sm shadow-sm" role="group">
            <a asp-action="Index" asp-route-status="All" 
               class="btn @(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "All" ? "btn-primary" : "btn-outline-primary")">
                All (@Model.TotalAppointments)
            </a>
            <a asp-action="Index" asp-route-status="Pending" 
               class="btn @(Model.StatusFilter == "Pending" ? "btn-warning text-dark" : "btn-outline-warning text-dark")">
                Pending (@Model.PendingAppointments)
            </a>
            <a asp-action="Index" asp-route-status="Confirmed" 
               class="btn @(Model.StatusFilter == "Confirmed" ? "btn-success" : "btn-outline-success")">
                Confirmed (@Model.ConfirmedAppointments)
            </a>
            <a asp-action="Index" asp-route-status="Cancelled" 
               class="btn @(Model.StatusFilter == "Cancelled" ? "btn-danger" : "btn-outline-danger")">
                Cancelled (@Model.CancelledAppointments)
            </a>
        </div>
    </div>

    <!-- Recent Appointments Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Patient Details</th>
                        <th>Doctor</th>
                        <th>Date & Time</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentAppointments.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No appointments found for the selected status.
                            </td>
                        </tr>
                    }
                    @foreach (var appt in Model.RecentAppointments)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">#MED-@appt.Id.ToString("D4")</td>
                            <td>
                                <div class="fw-bold">@appt.PatientName</div>
                                <div class="small text-muted">
                                    <i class="bi bi-envelope me-1"></i>@appt.PatientEmail &bull; 
                                    <i class="bi bi-telephone me-1"></i>@appt.PatientPhone
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold">@appt.Doctor?.Name</div>
                                <small class="text-teal">@appt.Doctor?.Specialization</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@appt.AppointmentDate.ToString("dd MMM yyyy")</div>
                                <small class="text-muted">@appt.AppointmentTime</small>
                            </td>
                            <td>
                                <span class="small text-truncate d-inline-block" style="max-width: 180px;" title="@appt.Reason">
                                    @appt.Reason
                                </span>
                            </td>
                            <td>
                                @if (appt.Status == "Confirmed")
                                {
                                    <span class="badge badge-status-confirmed"><i class="bi bi-check-circle me-1"></i>Confirmed</span>
                                }
                                else if (appt.Status == "Cancelled")
                                {
                                    <span class="badge badge-status-cancelled"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge badge-status-pending"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    @if (appt.Status != "Confirmed")
                                    {
                                        <form asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@appt.Id" />
                                            <input type="hidden" name="newStatus" value="Confirmed" />
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded-start" title="Confirm Appointment">
                                                <i class="bi bi-check-lg"></i> Confirm
                                            </button>
                                        </form>
                                    }
                                    @if (appt.Status != "Cancelled")
                                    {
                                        <form asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@appt.Id" />
                                            <input type="hidden" name="newStatus" value="Cancelled" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-end" title="Cancel Appointment">
                                                <i class="bi bi-x-lg"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
