@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="bg-white p-5 rounded-4 shadow-sm border">
                <div class="text-danger display-3 mb-3">
                    <i class="bi bi-shield-slash"></i>
                </div>
                <h3 class="fw-bold mb-2">Access Denied</h3>
                <p class="text-muted mb-4">
                    You do not have the required administrative permissions to access this clinical control area.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Return Home
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary rounded-pill px-4">
                        Login as Admin
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
