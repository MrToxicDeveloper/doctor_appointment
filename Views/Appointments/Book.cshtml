@model MediCare.ViewModels.BookAppointmentViewModel
@{
    ViewData["Title"] = "Book an Appointment";
    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="bg-primary-subtle py-4 border-bottom">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="fw-bold text-dark mb-1">Book a Doctor's Appointment</h2>
                <p class="text-muted mb-0">Fill in the patient details and select a convenient consultation date and time slot.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-controller="Appointments" asp-action="MyAppointments" class="btn btn-outline-primary rounded-pill">
                    <i class="bi bi-calendar-check me-1"></i> View Existing Appointments
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @if (Model.SelectedDoctor != null)
            {
                <!-- Pre-selected Doctor Summary Card -->
                <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white border-start border-4 border-primary">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrEmpty(Model.SelectedDoctor.ProfilePictureUrl) ? "/images/doctors/default-doctor.svg" : Model.SelectedDoctor.ProfilePictureUrl)" 
                             alt="@Model.SelectedDoctor.Name" class="rounded-circle border" style="width: 60px; height: 60px; object-fit: cover;">
                        <div>
                            <div class="text-teal small fw-semibold">You are booking with</div>
                            <h5 class="fw-bold mb-0">@Model.SelectedDoctor.Name</h5>
                            <div class="text-muted small">
                                <span class="badge bg-teal-subtle text-teal me-2">@Model.SelectedDoctor.Specialization</span>
                                <span>Fee: <strong>₹@Model.SelectedDoctor.ConsultationFee.ToString("N0")</strong></span> &bull; 
                                <span>Available: @Model.SelectedDoctor.AvailableDays</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="form-card">
                <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom">
                    <span class="bg-primary text-white p-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-file-earmark-medical"></i>
                    </span>
                    <h4 class="fw-bold mb-0">Patient & Consultation Information</h4>
                </div>

                <form asp-controller="Appointments" asp-action="Book" method="post" id="bookingForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4" role="alert"></div>

                    <!-- Row 1: Patient Name & Email -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PatientName" class="form-label">
                                Patient Full Name <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input asp-for="PatientName" class="form-control" placeholder="e.g. Ramesh Kumar" />
                            </div>
                            <span asp-validation-for="PatientName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PatientEmail" class="form-label">
                                Email Address <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input asp-for="PatientEmail" class="form-control" type="email" placeholder="patient@example.com" />
                            </div>
                            <span asp-validation-for="PatientEmail" class="text-danger small"></span>
                            <div class="form-text">Your appointment confirmation will be associated with this email.</div>
                        </div>
                    </div>

                    <!-- Row 2: Phone & Doctor Selection -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PatientPhone" class="form-label">
                                Phone Number <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                <input asp-for="PatientPhone" class="form-control" type="tel" placeholder="e.g. 9876543210" />
                            </div>
                            <span asp-validation-for="PatientPhone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DoctorId" class="form-label">
                                Select Doctor <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-hospital"></i></span>
                                <select asp-for="DoctorId" asp-items="Model.DoctorList" class="form-select">
                                    <option value="">-- Choose Specialist Doctor --</option>
                                </select>
                            </div>
                            <span asp-validation-for="DoctorId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Row 3: Appointment Date & Time Slot -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="AppointmentDate" class="form-label">
                                Appointment Date <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-calendar3"></i></span>
                                <input asp-for="AppointmentDate" type="date" min="@todayStr" class="form-control" />
                            </div>
                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                            <div class="form-text">Cannot be in the past (minimum date: today).</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AppointmentTime" class="form-label">
                                Available Time Slot <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-clock"></i></span>
                                <select asp-for="AppointmentTime" class="form-select">
                                    <option value="">-- Select Time Slot --</option>
                                    @foreach (var slot in MediCare.ViewModels.BookAppointmentViewModel.StandardTimeSlots)
                                    {
                                        if (Model.AppointmentTime == slot)
                                        {
                                            <option value="@slot" selected>@slot</option>
                                        }
                                        else
                                        {
                                            <option value="@slot">@slot</option>
                                        }
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="AppointmentTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Row 4: Reason for Visit -->
                    <div class="mb-4">
                        <label asp-for="Reason" class="form-label">
                            Reason for Visit / Symptoms <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Reason" class="form-control" rows="3" 
                                  placeholder="Briefly describe your symptoms, concern, or reason for this consultation..."></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <!-- Notice on slot collision protection -->
                    <div class="alert alert-light border small text-muted mb-4 d-flex align-items-center">
                        <i class="bi bi-shield-check text-teal fs-4 me-3"></i>
                        <div>
                            <strong>Instant Slot Verification:</strong> Our system prevents duplicate bookings for the same doctor and slot. If a slot is already taken, you'll be prompted immediately to pick an alternative.
                        </div>
                    </div>

                    <!-- Submit Buttons -->
                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                        <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Confirm & Book Appointment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
